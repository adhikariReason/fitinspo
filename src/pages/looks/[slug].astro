---
import Base from '../../layouts/Base.astro';
import SaveButton from '../../components/SaveButton.astro';
import Botanical from '../../components/Botanical.astro';
import LookTile from '../../components/LookTile.astro';
import { allLooks, relatedLooks } from '../../data/looks';
import { SITE, amazonLink, categoryLabel, tagLabel, DISCLOSURE_SHORT } from '../../data/site';

export async function getStaticPaths() {
  const looks = await allLooks();
  // The param is the frontmatter `slug`, which never changes once published.
  return looks.map((look) => ({ params: { slug: look.data.slug }, props: { look } }));
}

const { look } = Astro.props;
const d = look.data;
const related = await relatedLooks(look, 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.intro,
  image: new URL(d.hero_image, Astro.site).toString(),
  datePublished: d.date.toISOString(),
  author: { '@type': 'Person', name: 'Kristina' },
  publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<Base title={d.title} description={d.intro} image={d.hero_image}>
  <header class="topbar">
    <a class="topbar__back" href="/">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
      All looks
    </a>
    <span class="topbar__mark">{SITE.wordmark}</span>
    <button type="button" class="icon-btn" data-share aria-label="Share this look">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3v12"></path><path d="M7 8l5-5 5 5"></path><path d="M5 14v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"></path>
      </svg>
    </button>
  </header>

  <main id="main">
    <section class="hero" aria-label="Look photo">
      <div class="hero__frame" style={`background: ${d.placeholder_bg}`}>
        <img class="hero__img" src={d.hero_image} alt={d.hero_alt} width="800" height="1200" fetchpriority="high" />
        <span class="script hero__note" style={`color: ${d.placeholder_ink}`}>{d.note}</span>
        <SaveButton slug={d.slug} />
      </div>
      <span class="hero__wordmark" aria-hidden="true">{SITE.name}</span>
    </section>

    <section class="look-intro">
      <h1>{d.title}</h1>
      <p>{d.intro}</p>
      {
        d.color_story.length > 0 && (
          <div class="color-story">
            <div class="color-story__dots" aria-hidden="true">
              {d.color_story.map((c) => <span class="color-story__dot" style={`background: ${c}`} />)}
            </div>
            {d.color_story_label && (
              <span class="color-story__label">Color story: {d.color_story_label}</span>
            )}
          </div>
        )
      }
    </section>

    <section class="shop-panel" aria-labelledby="shop-heading">
      <Botanical />
      <h2 id="shop-heading">Shop the look</h2>
      <div>
        {
          d.items.map((item) => (
            <div class="shop-row">
              <div class="shop-row__text">
                <span class="shop-row__name">{item.name}</span>
                <span class="shop-row__note">{item.note}</span>
              </div>
              <a
                class="btn-shop"
                href={amazonLink(item.amazon_url)}
                rel="nofollow sponsored noopener"
                target="_blank"
                aria-label={`Shop ${item.name} on Amazon`}
              >
                Shop on Amazon
              </a>
            </div>
          ))
        }
      </div>
      <p class="disclosure-line">{DISCLOSURE_SHORT}</p>
    </section>

    {
      related.length > 0 && (
        <section class="more" aria-labelledby="more-heading">
          <h2 id="more-heading">You might also like</h2>
          <div class="grid">
            {related.map((r) => <LookTile look={r} small />)}
          </div>
        </section>
      )
    }

    <nav class="more" aria-label="Browse" style="padding-top:8px">
      <div class="chips" style="padding-left:0;padding-right:0">
        <a class="chip" href={`/category/${d.category}/`}>{categoryLabel(d.category)}</a>
        {d.tags.map((t) => <a class="chip" href={`/tag/${t}/`}>{tagLabel(t)}</a>)}
      </div>
    </nav>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <script>
    // Native share sheet where available, clipboard otherwise.
    const button = document.querySelector<HTMLButtonElement>('[data-share]');
    button?.addEventListener('click', async () => {
      const share = { title: document.title, url: location.href };
      try {
        if (navigator.share) {
          await navigator.share(share);
          return;
        }
        await navigator.clipboard.writeText(location.href);
        button.setAttribute('aria-label', 'Link copied');
      } catch {
        /* The user dismissed the sheet, or neither API is available. */
      }
    });
  </script>
</Base>
