---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
---

<Base title="Page not found" description="That page doesn't exist." noindex>
  <Masthead />
  <main id="main" class="prose">
    <h1>Not here</h1>
    <p>That link doesn't go anywhere. It may have been a look that was taken down.</p>
    <p><a href="/">Browse all looks</a></p>
  </main>
</Base>
