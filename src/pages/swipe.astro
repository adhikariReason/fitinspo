---
import Base from '../layouts/Base.astro';
import Heart from '../components/Heart.astro';
import { allLooks } from '../data/looks';
import { path } from '../data/site';
import { allCategories } from '../data/looks';
import type { SwipeCategory } from '../scripts/swipe';

const looks = await allLooks();
const categories_ = await allCategories();

// Grouped by category, in the order from site.ts: that order is the vertical axis.
const categories: SwipeCategory[] = categories_.map((c) => ({
  slug: c.slug,
  label: c.label,
  looks: looks
    .filter((l) => l.data.category === c.slug)
    .map((l) => ({
      slug: l.data.slug,
      title: l.data.title,
      note: l.data.note,
      count: l.data.items.length,
      bg: l.data.placeholder_bg,
      ink: l.data.placeholder_ink,
      image: path(l.data.hero_image),
      alt: l.data.hero_alt,
      url: path(`/looks/${l.data.slug}/`),
    })),
})).filter((c) => c.looks.length > 0);

const first = categories[0];
const firstLook = first?.looks[0];
---

<Base
  title="Swipe through looks"
  description="Swipe through every outfit. Sideways for looks, up and down for categories."
  footer={false}
  noindex
>
  <div class="sw" data-swipe>
    <header class="sw__top">
      <a class="icon-btn" href={path('/')} aria-label="Back to all looks">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12"></path><path d="M18 6L6 18"></path></svg>
      </a>
      <div class="sw__title">
        <span class="sw__cat" data-cat-name>{first?.label}</span>
        <div class="sw__dots" data-dots aria-hidden="true"></div>
      </div>
      <span class="sw__pos" data-position></span>
    </header>

    <div class="sw__stage">
      <div class="sw__peek" data-peek aria-hidden="true">
        <span class="script sw__peek-note" data-peek-note></span>
      </div>

      <article class="sw__card" data-card>
        <div class="sw__photo" data-photo style={`background: ${firstLook?.bg}`}>
          <img class="sw__img" data-img src={firstLook?.image} alt={firstLook?.alt} width="800" height="1200" />
          <span class="script sw__note" data-note></span>
          <button type="button" class="save-btn" data-card-save data-save={firstLook?.slug} aria-pressed="false" aria-label="Save this look">
            <Heart size={22} />
          </button>
        </div>
        <div class="sw__bar">
          <div class="sw__bar-text">
            <span class="sw__look-title" data-title></span>
            <span class="tile__sub" data-count></span>
          </div>
          <a class="btn-shop" data-shop href={firstLook?.url}>Shop this look</a>
        </div>
      </article>

      <nav class="sw__vnav" aria-label="Categories">
        <button type="button" class="sw__vbtn" data-prev-cat aria-label="Previous category">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--taupe)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6"></path></svg>
        </button>
        <div class="sw__vdots" data-cat-dots aria-hidden="true"></div>
        <button type="button" class="sw__vbtn" data-next-cat aria-label="Next category">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--taupe)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </button>
      </nav>
    </div>

    <footer class="sw__foot">
      <button type="button" class="sw__rbtn" data-prev-look aria-label="Previous look">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
      </button>
      <span class="sw__hint" data-hint>Swipe sideways for looks, up or down for categories</span>
      <button type="button" class="sw__rbtn" data-next-look aria-label="Next look">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
      </button>
    </footer>

    <p class="visually-hidden" role="status" aria-live="polite" data-live></p>
  </div>

  <script define:vars={{ categories }}>
    window.__fitinspoSwipe = categories;
  </script>
  <script>
    import { initSwipe } from '../scripts/swipe';
    const fromUrl = new URLSearchParams(location.search).get('category') ?? undefined;
    initSwipe(window.__fitinspoSwipe ?? [], fromUrl);
  </script>
</Base>

<style>
  /* The swipe browser owns the whole viewport, so it is styled here rather
     than in global.css where nothing else would use these rules. */
  .sw {
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--cream);
  }
  .sw__top {
    height: 64px;
    flex-shrink: 0;
    padding: 0 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .sw__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .sw__cat {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 22px;
    line-height: 1;
  }
  .sw__dots {
    display: flex;
    gap: 5px;
  }
  .sw-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: var(--line-strong);
    transition: width 180ms ease;
  }
  .sw-dot--on {
    width: 16px;
    background: var(--terracotta);
  }
  .sw__pos {
    width: 44px;
    text-align: center;
    font-size: 13px;
    color: var(--taupe);
  }

  .sw__stage {
    flex: 1;
    position: relative;
    margin: 4px 46px 0 18px;
  }
  .sw__peek {
    position: absolute;
    inset: 0;
    border-radius: 24px;
    transform: translateY(14px) scale(0.94);
    opacity: 0.7;
    padding: 20px;
    display: flex;
    align-items: flex-start;
  }
  .sw__peek-note {
    font-size: 20px;
    transform: rotate(-5deg);
    max-width: 160px;
  }
  .sw__card {
    position: absolute;
    inset: 0;
    border-radius: 24px;
    background: var(--paper);
    border: 1px solid var(--line-warm);
    box-shadow: 0 10px 30px rgba(75, 50, 36, 0.14);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
  }
  .sw__card:active {
    cursor: grabbing;
  }
  .sw__photo {
    flex: 1;
    position: relative;
    min-height: 0;
  }
  .sw__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .sw__note {
    position: absolute;
    top: 20px;
    left: 20px;
    font-size: 22px;
    transform: rotate(-5deg);
    max-width: 170px;
    text-shadow: 0 1px 6px rgba(251, 244, 236, 0.65);
  }
  .sw__bar {
    flex-shrink: 0;
    padding: 14px 16px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .sw__bar-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sw__look-title {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 21px;
    line-height: 1.1;
  }

  .sw__vnav {
    position: absolute;
    top: 0;
    bottom: 0;
    right: -40px;
    width: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .sw__vbtn {
    width: 32px;
    height: var(--tap);
    border: none;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .sw__vdots {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .sw-vdot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: var(--line-strong);
    transition: height 180ms ease;
  }
  .sw-vdot--on {
    height: 18px;
    background: var(--espresso);
  }

  .sw__foot {
    flex-shrink: 0;
    padding: 14px 18px 22px;
    display: flex;
    gap: 14px;
    align-items: center;
    justify-content: center;
  }
  .sw__rbtn {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--espresso);
    flex-shrink: 0;
  }
  .sw__hint {
    font-size: 14px;
    color: var(--taupe);
    min-width: 150px;
    text-align: center;
  }
</style>
