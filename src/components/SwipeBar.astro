---
/** Sticky bottom call to action that opens the swipe browser. */
interface Props {
  href?: string;
}
const { href = '/swipe/' } = Astro.props;
---
<div class="swipe-bar">
  <a href={href}>
    Swipe through looks
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M8 5l-4 4 4 4"></path>
      <path d="M16 11l4 4-4 4"></path>
      <path d="M4 9h11"></path>
      <path d="M20 15H9"></path>
    </svg>
  </a>
</div>
