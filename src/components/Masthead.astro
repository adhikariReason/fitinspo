---
import Heart from './Heart.astro';
import { SITE, path } from '../data/site';

interface Props {
  /** `h1` on the home page, `p` elsewhere so each page has one h1. */
  heading?: boolean;
}
const { heading = false } = Astro.props;
const Tag = heading ? 'h1' : 'p';
---
<header class="masthead">
  <Tag class="masthead__words" style="margin:0">
    <span class="masthead__mark">{SITE.wordmark}</span>
    <span class="masthead__by">{SITE.byline}</span>
  </Tag>
  <a class="saved-link" href={path('/saved/')} aria-label="Saved looks">
    <Heart size={20} />
    <span class="saved-badge" data-saved-count data-count="0" aria-hidden="true">0</span>
  </a>
</header>
