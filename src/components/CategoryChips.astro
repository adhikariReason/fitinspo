---
import { CATEGORIES } from '../data/site';

/**
 * Category filter. These are real links to the category pages rather than a
 * client-side filter, so each category has a crawlable, pinnable URL (spec 9).
 */
interface Props {
  /** Category slug of the current page, or 'all'. */
  active: string;
}
const { active } = Astro.props;
---
<nav class="chips" aria-label="Categories">
  <a class="chip" href="/" aria-current={active === 'all' ? 'page' : undefined}>All</a>
  {
    CATEGORIES.map((c) => (
      <a class="chip" href={`/category/${c.slug}/`} aria-current={active === c.slug ? 'page' : undefined}>
        {c.label}
      </a>
    ))
  }
</nav>
