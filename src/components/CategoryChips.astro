---
import { path } from '../data/site';
import { allCategories } from '../data/looks';

/**
 * Category filter. These are real links to the category pages rather than a
 * client-side filter, so each category has a crawlable, pinnable URL (spec 9).
 */
interface Props {
  /** Category slug of the current page, or 'all'. */
  active: string;
}
const { active } = Astro.props;
const categories = await allCategories();
---
<nav class="chips" aria-label="Categories">
  <a class="chip" href={path('/')} aria-current={active === 'all' ? 'page' : undefined}>All</a>
  {
    categories.map((c) => (
      <a class="chip" href={path(`/category/${c.slug}/`)} aria-current={active === c.slug ? 'page' : undefined}>
        {c.label}
      </a>
    ))
  }
</nav>
